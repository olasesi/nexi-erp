# Copy to .env.local for local development. All values are compiled into the
# bundle by Vite at build time — runtime container env has no effect.

# API origin. Leave empty to use the same origin:
#   dev:    Vite proxies /api -> http://localhost:8000
#   Docker: the bundled Nginx proxies /api -> the Laravel container
VITE_API_URL=

# Sentry DSN. Leave empty to disable error/performance reporting.
VITE_SENTRY_DSN=

# Client log threshold: trace | debug | info | warn | error
VITE_LOG_LEVEL=debug

# Sentry release name. Defaults to the package.json version.
VITE_APP_VERSION=
