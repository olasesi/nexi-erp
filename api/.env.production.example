# Nexi ERP - production environment for docker-compose.prod.yml
#
#   cp api/.env.production.example api/.env.production
#   # edit the values marked <<required>>, then:
#   docker compose --env-file api/.env.production -f docker-compose.prod.yml up -d
#
# This single file drives both the Laravel containers (via env_file) and the
# compose variable substitution (DB_*, HTTP_PORT, APP_URL), so credentials are
# only ever written in one place.

# --- Application -----------------------------------------------------------
APP_NAME="Nexi ERP"
APP_ENV=production
APP_KEY=                       # <<required>> php artisan key:generate --show
APP_DEBUG=false
# Public origin of the deployment (the address users type in the browser).
APP_URL=https://erp.example.com
FRONTEND_URL=https://erp.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Port on the host that publishes the SPA/ingress (change behind a reverse proxy).
HTTP_PORT=80

# --- Database --------------------------------------------------------------
DB_CONNECTION=mysql
DB_DATABASE=nexi_erp
DB_USERNAME=nexi
DB_PASSWORD=                   # <<required>>
DB_ROOT_PASSWORD=              # <<required>> MySQL root password

# --- Cache / queue / sessions ---------------------------------------------
# Pinned to redis by docker-compose.prod.yml; listed here for reference.
SESSION_DRIVER=database
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Storage ---------------------------------------------------------------
# 'public' stores uploads on the shared storage volume, served at {APP_URL}/storage.
# Switch to 's3' and fill the AWS_* block below for object storage.
FILESYSTEM_DISK=public

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Laravel Passport (OAuth2) ---------------------------------------------
# Create once with: docker compose -f docker-compose.prod.yml exec app \
#   php artisan passport:client --password
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# --- Mail ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Nexi ERP"

# --- Error tracking --------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=false

# --- Webhooks / analytics --------------------------------------------------
# Run deliveries through the queue worker (default) or 'sync' for in-process.
WEBHOOK_DRIVER=queue
ANALYTICS_CACHE_TTL=300

# --- API versioning --------------------------------------------------------
API_DEFAULT_VERSION=v1
