# Nginx front for the PHP-FPM `app` service. It bakes a copy of Laravel's
# public/ directory so nginx can serve static assets (and the storage symlink)
# directly, while PHP is executed by the `app` (php-fpm) container over FastCGI.
#
# Uploaded files live in storage/app/public, which is a shared volume mounted at
# /var/www/html/storage in both this container and the app container, so the
# public/storage symlink resolves to the very same files the app writes.
FROM nginx:1.27-alpine

WORKDIR /var/www/html

COPY public /var/www/html/public
COPY docker/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

RUN ln -s /var/www/html/storage/app/public /var/www/html/public/storage

EXPOSE 80
